<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE for the stock Zeekr overseas Firebase project config.

  Copy this file to `secrets_firebase.xml` (same directory, drop the .example) and paste in
  the real values (reported separately / extracted from the decompiled stock APK's
  res/values/strings.xml). These are CLIENT-side config values, present verbatim in the
  shipped stock APK - NOT private keys. We MUST reuse the stock project's values because the
  car's backend pushes through the STOCK app's Firebase project; a token minted under any
  other project would never receive those pushes.

  FirebaseInitProvider (pulled in transitively via firebase-messaging -> firebase-common)
  auto-initializes the default FirebaseApp from THESE string resources at process start - no
  google-services Gradle plugin and no google-services.json are needed. `google_app_id` is
  the only mandatory value; the rest complete FirebaseOptions.

  `secrets_firebase.xml` is GITIGNORED (same policy as the other secrets). On a fresh clone
  it is absent; the app still builds, FirebaseInitProvider just logs "initialization
  unsuccessful" and push is disabled until the file is restored.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">
    <string name="google_app_id" translatable="false">PASTE_google_app_id</string>
    <string name="gcm_defaultSenderId" translatable="false">PASTE_gcm_defaultSenderId</string>
    <string name="google_api_key" translatable="false">PASTE_google_api_key</string>
    <string name="google_crash_reporting_api_key" translatable="false">PASTE_google_api_key</string>
    <string name="project_id" translatable="false">PASTE_project_id</string>
    <string name="google_storage_bucket" translatable="false">PASTE_google_storage_bucket</string>
    <string name="default_web_client_id" translatable="false">PASTE_default_web_client_id</string>
</resources>
