<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cloud (TSP) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keep the BLE digital-key session alive in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Keep the CPU awake while the keep-alive/proximity loop runs with the screen off; a FGS
         alone does not prevent CPU suspend, and without it the screen-off BLE scan never flushes
         (confirmed: with wakelock the phone finds the car screen-off, without it, nothing). Held
         only while ProximityService is running. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- BLE digital-key / remote-parking channel (no neverForLocation: RSSI ranging
         + MAC read for approach unlock is a location-derived use). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application>
        <!-- Fully-qualified: this manifest's package is the core namespace, but the
             class lives in com.openzeekr.app.ble. Merges into :app and :wear. -->
        <service
            android:name="com.openzeekr.app.ble.ProximityService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Receives the hardware-offloaded presence scan (PendingIntent from the BLE controller):
             FIRST_MATCH wakes the app to connect, MATCH_LOST re-idles it. exported=false is fine —
             the system delivers our own PendingIntent to our own explicit component. -->
        <receiver
            android:name="com.openzeekr.app.ble.BleScanReceiver"
            android:exported="false" />
    </application>
</manifest>
